# Snyk policy file. Ignored issues must have an actionable reason and an
# expiry. Revisit when the Angular CLI toolchain bumps less past 4.6.7
# (@angular-devkit/build-angular@22.2.0 already pins less@4.8.1, which drops
# the image-size optional dependency entirely).
version: v1.25.0
ignore:
  SNYK-JS-IMAGESIZE-17295814:
    - '*':
        reason: >-
          image-size@0.5.5 (CVE-2025-71329, infinite loop) is an optional
          dependency of less@4.6.7, which @angular-devkit/build-angular@22.1.3
          pins exactly. Build-time only, never loaded at runtime in this
          repository. No patched 0.5.x release exists; the fix lives in the
          1.x/2.x lines, outside less's ~0.5.0 range. The chain is required by
          @analogjs/vite-plugin-angular (vitest) and angular-app (ng build) and
          cannot be removed without upstream changes. Revisit when Angular CLI
          22.2.0 becomes stable.
        expires: 2027-01-01T00:00:00.000Z
  SNYK-JS-IMAGESIZE-17295816:
    - '*':
        reason: >-
          image-size@0.5.5 (CVE-2025-71330, infinite loop) is an optional
          dependency of less@4.6.7, which @angular-devkit/build-angular@22.1.3
          pins exactly. Build-time only, never loaded at runtime in this
          repository. No patched 0.5.x release exists; the fix lives in the
          1.x/2.x lines, outside less's ~0.5.0 range. The chain is required by
          @analogjs/vite-plugin-angular (vitest) and angular-app (ng build) and
          cannot be removed without upstream changes. Revisit when Angular CLI
          22.2.0 becomes stable.
        expires: 2027-01-01T00:00:00.000Z
