+/** @type {WeakMap<string[], string[]>} */
+const sortedPackedFiles = new WeakMap()
+
+/**
+ * Same result as `packedFiles.some((file) => file.startsWith(prefix))`, but
+ * with a binary search over a sorted copy instead of a scan of every file for
+ * every directory entry (quadratic on packages with thousands of files).
+ * @param {string[]} packedFiles
+ * @param {string} prefix
+ */
+function hasPackedFileWithPrefix(packedFiles, prefix) {
+  let sorted = sortedPackedFiles.get(packedFiles)
+  if (!sorted) {
+    sorted = [...packedFiles].sort()
+    sortedPackedFiles.set(packedFiles, sorted)
+  }
+  let low = 0
+  let high = sorted.length
+  while (low < high) {
+    const mid = (low + high) >> 1
+    if (sorted[mid] < prefix) low = mid + 1
+    else high = mid
+  }
+  return low < sorted.length && sorted[low].startsWith(prefix)
+}
