{
  "name": "@solar-icons/figma-plugin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:catalog": "node scripts/check-catalog.mjs",
    "capture:community": "pnpm build && node scripts/capture-community-screens.mjs && node scripts/generate-community-assets.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "fuse.js": "^7.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@calcom/cal-sans-ui": "^1.3.0",
    "@figma/plugin-typings": "^1.132.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@iconify-json/devicon": "^1.2.62",
    "@iconify-json/vscode-icons": "^1.2.68",
    "@solar-icons/static": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
