{
  "name": "@solar-icons/figma-plugin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:catalog": "node scripts/check-catalog.mjs",
    "capture:community": "pnpm build && node scripts/capture-community-screens.mjs && node scripts/generate-community-assets.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "fuse.js": "^7.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.138.0",
    "@fontsource-variable/aleo": "^5.3.0",
    "@fontsource-variable/host-grotesk": "^5.3.0",
    "@iconify-json/devicon": "^1.2.63",
    "@iconify-json/vscode-icons": "^1.2.77",
    "@solar-icons/static": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
