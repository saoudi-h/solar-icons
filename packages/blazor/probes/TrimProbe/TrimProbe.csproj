<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <AspNetVersion Condition="'$(TargetFramework)' == 'net8.0'">8.0.32</AspNetVersion>
    <AspNetVersion Condition="'$(TargetFramework)' == 'net10.0'">10.0.13</AspNetVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ProbeCase Condition="'$(ProbeCase)' == ''">STATIC_1</ProbeCase>
    <WasmEnableWebcil>false</WasmEnableWebcil>
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="$(AspNetVersion)" />
    <PackageReference Include="SolarIcons.Blazor" Version="2.1.0" />
    <Compile Remove="Generated/**/*.cs" />
    <Compile Include="Generated/$(ProbeCase).g.cs" />
  </ItemGroup>

</Project>
