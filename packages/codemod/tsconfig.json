{
    "extends": "@tala-tools/tsconfig/base.json",
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noEmit": true,
        "types": ["node"]
    },
    "include": [
        "scripts/**/*",
        "src/**/*",
        "tests/**/*",
        "eslint.config.ts",
        "vitest.config.ts",
        "tsdown.config.ts"
    ],
    "exclude": ["dist", "node_modules", "LICENSE", "LICENSE-THIRD-PARTY"]
}
