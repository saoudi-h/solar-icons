{
    "name": "@solar-icons/codemod",
    "version": "2.0.0-beta.2",
    "private": false,
    "publishConfig": {
        "access": "public"
    },
    "description": "Conservative migration codemods for Solar Icons",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/saoudi-h/solar-icons.git",
        "directory": "packages/codemod"
    },
    "type": "module",
    "bin": {
        "solar-icons-migrate": "./dist/cli.mjs"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "LICENSE-THIRD-PARTY"
    ],
    "scripts": {
        "build": "pnpm copy:licenses && tsdown -l error",
        "copy:licenses": "cp ../../LICENSE ./LICENSE && cp ../../LICENSE-THIRD-PARTY ./LICENSE-THIRD-PARTY",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix",
        "format": "prettier \"**/*\" --ignore-unknown --list-different",
        "format:fix": "prettier \"**/*\" --ignore-unknown --write",
        "clean": "rimraf *.tsbuildinfo node_modules dist",
        "test": "vitest run",
        "test:fixtures": "tsx scripts/run-fixtures.ts",
        "typecheck": "tsgo --noEmit",
        "pre-commit": "lint-staged"
    },
    "types": "./dist/index.d.mts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "dependencies": {
        "@clack/prompts": "^1.7.0",
        "@vue/compiler-sfc": "^3.5.39",
        "commander": "^15.0.0",
        "picocolors": "^1.1.1",
        "svelte": "^5.56.4",
        "typescript": "^6.0.3"
    },
    "devDependencies": {
        "@tala-tools/eslint": "0.1.4",
        "@tala-tools/prettier": "0.0.3",
        "@tala-tools/tsconfig": "0.0.1",
        "@types/node": "^26.1.1",
        "prettier": "^3.9.4",
        "rimraf": "^6.1.3",
        "tsdown": "^0.22.4",
        "tsx": "^4.23.0",
        "vitest": "^4.1.10"
    },
    "engines": {
        "node": ">=18"
    },
    "keywords": [
        "solar-icons",
        "codemod",
        "migration"
    ],
    "author": {
        "name": "Saoudi Hakim",
        "url": "https://hakimsaoudi.dev",
        "email": "saoudi-hakim@outlook.com"
    },
    "license": "MIT"
}
