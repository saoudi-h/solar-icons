{
    "name": "@solar-icons/codemod",
    "version": "2.0.0",
    "private": false,
    "description": "Conservative migration codemods for Solar Icons",
    "keywords": [
        "codemod",
        "migration",
        "solar-icons"
    ],
    "license": "MIT",
    "author": {
        "name": "Saoudi Hakim",
        "email": "saoudi-hakim@outlook.com",
        "url": "https://hakimsaoudi.dev"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/saoudi-h/solar-icons.git",
        "directory": "packages/codemod"
    },
    "bin": {
        "codemod": "./dist/cli.mjs",
        "solar-icons-migrate": "./dist/cli.mjs"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "LICENSE-THIRD-PARTY"
    ],
    "type": "module",
    "types": "./dist/index.d.mts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "pnpm copy:licenses && tsdown -l error",
        "copy:licenses": "cp ../../LICENSE ./LICENSE && cp ../../LICENSE-THIRD-PARTY ./LICENSE-THIRD-PARTY",
        "lint": "oxlint --deny-warnings .",
        "lint:fix": "oxlint --fix .",
        "format": "oxfmt --check .",
        "format:fix": "oxfmt --write .",
        "clean": "rimraf *.tsbuildinfo node_modules dist",
        "test": "vitest run",
        "test:fixtures": "tsx scripts/run-fixtures.ts",
        "typecheck": "tsc --noEmit",
        "pre-commit": "lint-staged"
    },
    "dependencies": {
        "@clack/prompts": "^1.7.0",
        "@vue/compiler-sfc": "^3.5.41",
        "commander": "^15.0.0",
        "picocolors": "^1.1.1",
        "svelte": "^5.56.8",
        "typescript": "^6.0.3"
    },
    "devDependencies": {
        "@tala-tools/tsconfig": "0.0.2",
        "@types/node": "^26.1.2",
        "rimraf": "^6.1.3",
        "tsdown": "^0.22.14",
        "tsx": "^4.23.8",
        "vitest": "^4.1.10"
    },
    "engines": {
        "node": ">=18"
    }
}
