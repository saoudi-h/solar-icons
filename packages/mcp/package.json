{
    "name": "@solar-icons/mcp",
    "version": "2.2.0",
    "private": false,
    "description": "MCP server for Solar Icons — search, get and list 1,380 icons × 6 styles via Model Context Protocol",
    "keywords": [
        "icons",
        "mcp",
        "model-context-protocol",
        "solar"
    ],
    "license": "MIT",
    "author": {
        "name": "Saoudi Hakim",
        "email": "saoudihakim@gmail.com",
        "url": "https://hakimsaoudi.dev"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/saoudi-h/solar-icons.git",
        "directory": "packages/mcp"
    },
    "bin": {
        "solar-icons-mcp": "./dist/index.js"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "LICENSE-THIRD-PARTY"
    ],
    "type": "module",
    "exports": {
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "pnpm copy:licenses && tsc -p tsconfig.json",
        "copy:licenses": "cp ../../LICENSE ./LICENSE && cp ../../LICENSE-THIRD-PARTY ./LICENSE-THIRD-PARTY",
        "lint": "oxlint --deny-warnings .",
        "lint:fix": "oxlint --fix .",
        "format": "oxfmt --check .",
        "format:fix": "oxfmt --write .",
        "clean": "rimraf dist LICENSE LICENSE-THIRD-PARTY",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "pre-commit": "lint-staged",
        "dev": "tsx watch src/index.ts",
        "start": "node dist/index.js"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.30.0",
        "@solar-icons/cli": "workspace:*",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@tala-tools/tsconfig": "0.0.2",
        "@types/node": "^26.5.1",
        "rimraf": "^6.1.3",
        "tsx": "^4.23.13",
        "typescript": "7.0.2",
        "vitest": "^4.1.11"
    },
    "engines": {
        "node": ">=18"
    }
}
