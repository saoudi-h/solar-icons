{
    "name": "@solar-icons/solid-v2",
    "version": "2.0.1",
    "description": "Solar Icons for Solid 2",
    "keywords": [
        "UI",
        "UX",
        "design",
        "icons",
        "interface",
        "solar",
        "solid",
        "solid-2",
        "solidjs",
        "svg"
    ],
    "bugs": {
        "url": "https://github.com/saoudi-h/solar-icons/issues"
    },
    "license": "MIT",
    "author": {
        "name": "Saoudi Hakim",
        "email": "saoudihakim@gmail.com",
        "url": "https://hakimsaoudi.dev"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/saoudi-h/solar-icons.git",
        "directory": "packages/solid-v2"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "LICENSE-THIRD-PARTY"
    ],
    "type": "module",
    "sideEffects": false,
    "types": "./dist/index.d.mts",
    "imports": {
        "#internal/icon-base": {
            "types": "./dist/lib/IconBase.d.mts",
            "solid": "./dist/source/lib/IconBase.jsx",
            "worker": "./dist/ssr/lib/IconBase.mjs",
            "browser": "./dist/lib/IconBase.mjs",
            "deno": "./dist/ssr/lib/IconBase.mjs",
            "node": "./dist/ssr/lib/IconBase.mjs",
            "default": "./dist/lib/IconBase.mjs"
        },
        "#internal/solar-provider": {
            "types": "./dist/lib/SolarProvider.d.mts",
            "solid": "./dist/source/lib/SolarProvider.jsx",
            "worker": "./dist/ssr/lib/SolarProvider.mjs",
            "browser": "./dist/lib/SolarProvider.mjs",
            "deno": "./dist/ssr/lib/SolarProvider.mjs",
            "node": "./dist/ssr/lib/SolarProvider.mjs",
            "default": "./dist/lib/SolarProvider.mjs"
        }
    },
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        },
        "./lib": {
            "types": "./dist/lib/index.d.mts",
            "import": "./dist/lib/index.mjs"
        },
        "./lib/IconBase": {
            "types": "./dist/lib/IconBase.d.mts",
            "solid": "./dist/source/lib/IconBase.jsx",
            "worker": "./dist/ssr/lib/IconBase.mjs",
            "browser": "./dist/lib/IconBase.mjs",
            "deno": "./dist/ssr/lib/IconBase.mjs",
            "node": "./dist/ssr/lib/IconBase.mjs",
            "import": "./dist/lib/IconBase.mjs"
        },
        "./lib/SolarProvider": {
            "types": "./dist/lib/SolarProvider.d.mts",
            "solid": "./dist/source/lib/SolarProvider.jsx",
            "worker": "./dist/ssr/lib/SolarProvider.mjs",
            "browser": "./dist/lib/SolarProvider.mjs",
            "deno": "./dist/ssr/lib/SolarProvider.mjs",
            "node": "./dist/ssr/lib/SolarProvider.mjs",
            "import": "./dist/lib/SolarProvider.mjs"
        },
        "./lib/*": {
            "types": "./dist/lib/*.d.mts",
            "import": "./dist/lib/*.mjs"
        },
        "./dynamic": {
            "types": "./dist/icons/dynamic/index.d.mts",
            "import": "./dist/icons/dynamic/index.mjs"
        },
        "./dynamic/*": {
            "types": "./dist/icons/dynamic/*.d.mts",
            "import": "./dist/icons/dynamic/*.mjs"
        },
        "./*": {
            "types": "./dist/icons/style/*.d.mts",
            "import": "./dist/icons/style/*.mjs"
        },
        "./bold/*": {
            "types": "./dist/icons/bold/*.d.mts",
            "import": "./dist/icons/bold/*.mjs"
        },
        "./bold-duotone/*": {
            "types": "./dist/icons/bold-duotone/*.d.mts",
            "import": "./dist/icons/bold-duotone/*.mjs"
        },
        "./broken/*": {
            "types": "./dist/icons/broken/*.d.mts",
            "import": "./dist/icons/broken/*.mjs"
        },
        "./line-duotone/*": {
            "types": "./dist/icons/line-duotone/*.d.mts",
            "import": "./dist/icons/line-duotone/*.mjs"
        },
        "./linear/*": {
            "types": "./dist/icons/linear/*.d.mts",
            "import": "./dist/icons/linear/*.mjs"
        },
        "./outline/*": {
            "types": "./dist/icons/outline/*.d.mts",
            "import": "./dist/icons/outline/*.mjs"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "pnpm generate:assets && pnpm copy:licenses && rimraf dist && tsdown -l error",
        "copy:licenses": "cp ../../LICENSE ./LICENSE && cp ../../LICENSE-THIRD-PARTY ./LICENSE-THIRD-PARTY",
        "generate:assets": "tsx scripts/generate-assets.ts",
        "lint": "oxlint --deny-warnings .",
        "lint:fix": "oxlint --fix .",
        "format": "oxfmt --check .",
        "format:fix": "oxfmt --write .",
        "clean": "rimraf *.tsbuildinfo node_modules build dist",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "pre-commit": "lint-staged"
    },
    "devDependencies": {
        "@solar-icons/core": "workspace:*",
        "@solidjs/vite-plugin": "^3.0.1",
        "@solidjs/web": "^2.0.0",
        "@tala-tools/tsconfig": "0.1.2",
        "@types/node": "^26.6.5",
        "csstype": "^3.2.3",
        "es-module-lexer": "^3.0.4",
        "jsdom": "^31.0.1",
        "picocolors": "^1.1.1",
        "rimraf": "^6.1.3",
        "solid-js": "^2.0.0",
        "tsdown": "^0.23.1",
        "typescript": "7.0.2",
        "unplugin-solid": "3.0.0",
        "vite": "^8.3.8",
        "vitest": "^5.0.5"
    },
    "peerDependencies": {
        "@solidjs/web": "^2.0.0",
        "solid-js": "^2.0.0"
    },
    "engines": {
        "node": ">=22.12.0"
    }
}
