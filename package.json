{
    "name": "solar",
    "private": true,
    "description": "Solar Icons",
    "keywords": [
        "UI",
        "UX",
        "design",
        "icons",
        "interface",
        "phosphor",
        "react",
        "solar",
        "svg"
    ],
    "license": "MIT",
    "author": {
        "name": "Saoudi Hakim",
        "email": "saoudihakim@gmail.com",
        "url": "https://hakimsaoudi.dev"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/saoudi-h/solar.git"
    },
    "type": "module",
    "scripts": {
        "build": "turbo build --concurrency=1",
        "dev": "turbo dev --concurrency=20",
        "lint": "turbo lint",
        "lint:fix": "turbo lint:fix",
        "format": "turbo format",
        "format:fix": "turbo format:fix",
        "clean": "turbo clean && rimraf node_modules",
        "version": "changeset version",
        "version-packages": "changeset version && tsx scripts/bump-polyglot-packages.ts --from-static && pnpm install --no-frozen-lockfile",
        "release": "changeset publish",
        "typecheck": "turbo typecheck",
        "check:exports": "node scripts/check-exports.mjs",
        "check:dist-imports": "node scripts/check-dist-imports.mjs",
        "check:figma-catalog": "pnpm --filter @solar-icons/static build && pnpm --filter @solar-icons/figma-plugin build && pnpm --filter @solar-icons/figma-plugin check:catalog",
        "check:icon-inventory": "tsx scripts/check-icon-inventory.ts --check-generated --check-docs",
        "check:registry": "tsx scripts/check-registry.ts",
        "check:listing": "tsx scripts/check-listing.ts",
        "check:skill-counts": "tsx scripts/check-skill-counts.ts",
        "generate:test-catalogs": "tsx scripts/generate-test-app-icon-lists.ts",
        "prepare:visual-package": "tsx scripts/prepare-visual-package.ts",
        "spell": "cspell \"**/*\" --no-progress",
        "prepare": "husky",
        "test": "turbo test",
        "pre-commit": "turbo pre-commit --concurrency=1",
        "setup": "pnpm install && pnpm build",
        "autonomos": "autonomos",
        "catalog:sync": "tsx scripts/sync-catalog.ts",
        "sync:icon-inventory": "tsx scripts/check-icon-inventory.ts --write --check-generated --check-docs",
        "polyglot:bump": "tsx scripts/bump-polyglot-packages.ts",
        "test:scripts": "tsx --test scripts/lib/*.test.ts"
    },
    "dependencies": {
        "@changesets/changelog-github": "^1.0.1",
        "@changesets/cli": "^3.0.3"
    },
    "devDependencies": {
        "@autonomos/cli": "^0.7.0",
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@commitlint/types": "^21.2.3",
        "@tala-tools/oxfmt": "0.0.2",
        "@tala-tools/oxlint": "0.0.3",
        "@tala-tools/tsconfig": "0.1.2",
        "@types/node": "^26.6.5",
        "cspell": "^10.4.0",
        "es-module-lexer": "^3.0.4",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "oxfmt": "^0.76.0",
        "oxlint": "^1.89.0",
        "publint": "^0.3.25",
        "rimraf": "^6.1.3",
        "tsx": "^4.23.15",
        "turbo": "^2.11.10",
        "unplugin-unused": "^0.6.0"
    },
    "engines": {
        "node": "26.x"
    },
    "packageManager": "pnpm@12.17.0"
}
