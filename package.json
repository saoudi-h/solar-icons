{
    "name": "solar",
    "private": true,
    "description": "Solar Icons",
    "type": "module",
    "scripts": {
        "build": "turbo build --concurrency=1",
        "dev": "turbo dev",
        "lint": "turbo lint",
        "lint:fix": "turbo lint:fix",
        "format": "turbo format",
        "format:fix": "turbo format:fix",
        "clean": "turbo clean && rimraf node_modules",
        "version": "changeset version",
        "version-packages": "changeset version && pnpm install --no-frozen-lockfile",
        "release": "changeset publish",
        "typecheck": "turbo typecheck",
        "check:exports": "node scripts/check-exports.mjs",
        "check:figma-catalog": "pnpm --filter @solar-icons/static build && pnpm --filter @solar-icons/figma-plugin build && pnpm --filter @solar-icons/figma-plugin check:catalog",
        "check:icon-inventory": "tsx scripts/check-icon-inventory.ts --check-generated --check-docs",
        "generate:test-catalogs": "tsx scripts/generate-test-app-icon-lists.ts",
        "prepare:visual-package": "tsx scripts/prepare-visual-package.ts",
        "spell": "cspell \"**/*\" --no-progress",
        "prepare": "husky",
        "test": "turbo test",
        "pre-commit": "turbo pre-commit --concurrency=1",
        "setup": "pnpm install && pnpm build",
        "autonomos": "autonomos"
    },
    "devDependencies": {
        "@autonomos/cli": "^0.6.0",
        "@commitlint/cli": "^21.2.2",
        "@commitlint/config-conventional": "^21.2.2",
        "@commitlint/types": "^21.2.0",
        "@tala-tools/tsconfig": "0.0.2",
        "@types/node": "^26.1.2",
        "cspell": "^10.0.1",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "publint": "^0.3.23",
        "rimraf": "^6.1.3",
        "tsdown": "^0.22.14",
        "tsx": "^4.23.8",
        "turbo": "^2.10.8",
        "typescript": "7.0.2",
        "unplugin-unused": "^0.6.0",
        "vite-tsconfig-paths": "^6.1.1",
        "@tala-tools/oxfmt": "0.0.1",
        "@tala-tools/oxlint": "0.0.1",
        "oxlint": "^1.79.0",
        "oxfmt": "^0.64.0"
    },
    "packageManager": "pnpm@11.5.3",
    "engines": {
        "node": ">=18"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/saoudi-h/solar.git"
    },
    "keywords": [
        "react",
        "icons",
        "svg",
        "solar",
        "design",
        "interface",
        "phosphor",
        "UI",
        "UX"
    ],
    "author": {
        "name": "Saoudi Hakim",
        "url": "https://hakimsaoudi.dev",
        "email": "saoudihakim@gmail.com"
    },
    "license": "MIT",
    "dependencies": {
        "@changesets/changelog-github": "^0.7.0",
        "@changesets/cli": "^2.31.1"
    }
}
