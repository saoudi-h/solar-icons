{
    "name": "angular-app",
    "version": "2.0.0-beta.0",
    "scripts": {
        "ng": "ng",
        "prestart": "pnpm prepare:catalog",
        "start": "ng serve",
        "prebuild": "pnpm prepare:catalog",
        "build": "ng build",
        "prepare:catalog": "pnpm -w prepare:visual-package @solar-icons/angular",
        "watch": "ng build --watch --configuration development",
        "clean": "rm -rf node_modules .angular"
    },
    "private": true,
    "packageManager": "pnpm@12.4.1",
    "dependencies": {
        "@angular/common": "^22.2.0",
        "@angular/compiler": "^22.2.0",
        "@angular/core": "^22.2.0",
        "@angular/material": "^22.2.0",
        "@angular/platform-browser": "^22.2.0",
        "@solar-icons/angular": "workspace:*",
        "@tailwindcss/postcss": "^4.3.3",
        "postcss": "^8.5.28",
        "rxjs": "~7.8.2",
        "tailwindcss": "^4.3.3",
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@angular/build": "^22.2.0",
        "@angular/cli": "^22.2.0",
        "@angular/compiler-cli": "^22.2.0",
        "typescript": "~6.0.3"
    }
}
