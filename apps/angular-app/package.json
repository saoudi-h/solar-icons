{
  "name": "angular-app",
  "version": "2.0.0-beta.0",
  "scripts": {
    "ng": "ng",
    "prestart": "pnpm prepare:catalog",
    "start": "ng serve",
    "prebuild": "pnpm prepare:catalog",
    "build": "ng build",
    "prepare:catalog": "pnpm -w prepare:visual-package @solar-icons/angular",
    "watch": "ng build --watch --configuration development",
    "clean": "rm -rf node_modules .angular"
  },
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "@angular/cdk": "^22.1.1",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.1.1",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@solar-icons/angular": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.25",
    "rxjs": "~7.8.2",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  }
}
