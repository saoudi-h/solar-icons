{
    "name": "@solar-icons/docs",
    "version": "2.0.0-beta.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "pnpm generate:catalog && tsx ./scripts/generate-changelog.ts && next build",
        "dev": "next dev --turbo",
        "predev": "pnpm generate:catalog",
        "start": "next start",
        "postinstall": "fumadocs-mdx",
        "lint": "oxlint --deny-warnings .",
        "lint:fix": "oxlint --fix .",
        "format": "oxfmt --check .",
        "format:fix": "oxfmt --write .",
        "typecheck": "tsc --noEmit",
        "typecheck:scripts": "tsc -p tsconfig.scripts.json",
        "clean": "rimraf *.tsbuildinfo node_modules build dist .turbo .next",
        "generate:hero:utils": "tsx ./scripts/generateHeroUtils.ts",
        "generate:data": "tsx ./scripts/generate-data.ts",
        "generate:descriptions": "tsx ./scripts/generate-descriptions.ts",
        "generate:catalog": "pnpm generate:data && pnpm generate:descriptions && pnpm generate:hero:utils",
        "lint-staged": "lint-staged",
        "pre-commit": "lint-staged",
        "lint:links": "fumadocs-mdx && bun scripts/lint.ts",
        "analyze": "ANALYZE=true pnpm run build"
    },
    "dependencies": {
        "@base-ui/react": "^1.7.0",
        "@calcom/cal-sans-ui": "^1.3.0",
        "@number-flow/react": "^0.6.2",
        "@radix-ui/react-dialog": "^1.1.23",
        "@radix-ui/react-dropdown-menu": "^2.1.24",
        "@radix-ui/react-popover": "^1.1.23",
        "@radix-ui/react-select": "^2.3.7",
        "@radix-ui/react-separator": "^1.1.15",
        "@radix-ui/react-slider": "^1.4.7",
        "@radix-ui/react-slot": "^1.3.3",
        "@radix-ui/react-tabs": "^1.1.21",
        "@radix-ui/react-toggle": "^1.1.18",
        "@radix-ui/react-tooltip": "^1.2.16",
        "@solar-icons/react": "workspace:*",
        "@t3-oss/env-nextjs": "^0.13.11",
        "@types/file-saver": "^2.0.7",
        "babel-plugin-react-compiler": "1.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "1.1.1",
        "file-saver": "^2.0.5",
        "fumadocs-core": "^16.15.5",
        "fumadocs-mdx": "^15.2.2",
        "fumadocs-typescript": "^5.3.0",
        "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.5",
        "fuse.js": "^7.4.2",
        "jotai": "^2.20.2",
        "lenis": "^1.3.26",
        "lucide-react": "^1.28.0",
        "motion": "^13.0.0",
        "next": "16.3.0",
        "next-themes": "^0.4.6",
        "nuqs": "^2.9.5",
        "octokit": "^5.0.5",
        "react": "^19.2.8",
        "react-colorful": "^5.8.0",
        "react-dom": "^19.2.8",
        "react-select": "^5.10.2",
        "react-virtualized": "^9.22.6",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.6.0",
        "tailwindcss-animate": "^1.0.7",
        "tw-screens": "^1.1.3",
        "vaul": "^1.1.2",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@iconify-icons/mdi": "2.0.0",
        "@iconify/react": "^6.0.2",
        "@next/bundle-analyzer": "^16.3.0",
        "@solar-icons/core": "workspace:*",
        "@tailwindcss/postcss": "^4.3.3",
        "@tala-tools/tsconfig": "0.0.2",
        "@types/mdx": "^2.0.14",
        "@types/node": "26.1.2",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@types/react-virtualized": "^9.22.3",
        "eslint-plugin-better-tailwindcss": "^4.7.0",
        "next-validate-link": "^1.6.7",
        "postcss": "^8.5.25",
        "sharp": "^0.35.3",
        "tailwindcss": "^4.3.3"
    }
}
