{
    "name": "static-app",
    "version": "2.0.0-beta.0",
    "private": true,
    "type": "module",
    "scripts": {
        "predev": "pnpm prepare:catalog",
        "dev": "vite",
        "prebuild": "pnpm prepare:catalog",
        "build": "vite build",
        "prepare:catalog": "pnpm -w generate:test-catalogs && pnpm --filter @solar-icons/static build",
        "preview": "vite preview",
        "clean": "rm -rf node_modules dist",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix",
        "format": "prettier \"**/*\" --ignore-unknown --list-different",
        "format:fix": "prettier \"**/*\" --ignore-unknown --write",
        "typecheck": "tsc --noEmit",
        "pre-commit": "lint-staged"
    },
    "dependencies": {
        "@solar-icons/static": "workspace:*"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@tala-tools/eslint": "0.1.5",
        "@tala-tools/prettier": "0.0.3",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "vite": "^8.2.0"
    }
}
