{
    "name": "static-app",
    "version": "2.0.0-beta.0",
    "private": true,
    "type": "module",
    "scripts": {
        "predev": "pnpm prepare:catalog",
        "dev": "vite",
        "prebuild": "pnpm prepare:catalog",
        "build": "vite build",
        "prepare:catalog": "pnpm -w prepare:visual-package @solar-icons/static",
        "preview": "vite preview",
        "clean": "rm -rf node_modules dist",
        "lint": "oxlint --deny-warnings .",
        "lint:fix": "oxlint --fix .",
        "format": "oxfmt --check .",
        "format:fix": "oxfmt --write .",
        "typecheck": "tsc --noEmit",
        "pre-commit": "lint-staged"
    },
    "dependencies": {
        "@solar-icons/static": "workspace:*"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "tailwindcss": "^4.3.3",
        "typescript": "7.0.2",
        "vite": "^8.2.0"
    }
}
