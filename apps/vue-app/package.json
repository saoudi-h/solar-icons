{
    "name": "vue-app",
    "version": "2.0.0-beta.0",
    "private": true,
    "type": "module",
    "scripts": {
        "predev": "pnpm prepare:catalog",
        "dev": "vite",
        "prebuild-only": "pnpm prepare:catalog",
        "build:skipped": "run-p type-check \"build-only {@}\" --",
        "preview": "vite preview",
        "build-only": "vite build",
        "prepare:catalog": "pnpm -w prepare:visual-package @solar-icons/vue",
        "type-check": "vue-tsc --build",
        "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
        "lint:eslint": "eslint . --fix",
        "lint": "oxlint --deny-warnings .",
        "format": "oxfmt --check .",
        "clean": "rm -rf node_modules dist .turbo",
        "format:fix": "oxfmt --write ."
    },
    "dependencies": {
        "@solar-icons/vue": "workspace:*",
        "@tailwindcss/vite": "^4.3.3",
        "@vueuse/core": "^15.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-vue-next": "^1.0.0",
        "reka-ui": "^2.10.5",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "vue": "^3.5.43",
        "vue-color": "^3.3.3",
        "vue-router": "^5.3.1",
        "vue-sonner": "^2.0.9"
    },
    "devDependencies": {
        "@tsconfig/node24": "^24.0.5",
        "@types/node": "^26.6.2",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vue/tsconfig": "^0.9.1",
        "jiti": "^2.7.0",
        "npm-run-all2": "^9.0.3",
        "typescript": "6.0.3",
        "vite": "^8.3.1",
        "vite-plugin-vue-devtools": "^8.2.1",
        "vue-tsc": "^3.3.11"
    },
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    }
}
