{
    "extends": "@tala-tools/tsconfig/base.json",
    "display": "Solid",
    "compilerOptions": {
        "jsx": "preserve",
        "jsxImportSource": "solid-js",
        "noUnusedLocals": false,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "target": "ESNext",
        "paths": {
            "~/*": ["./src/*"],
            "@solar-icons/solid": ["../../packages/solid/src/index.ts"],
            "@solar-icons/solid/bold": ["../../packages/solid/src/icons/style/bold.ts"],
            "@solar-icons/solid/bold-duotone": [
                "../../packages/solid/src/icons/style/bold-duotone.ts"
            ],
            "@solar-icons/solid/broken": ["../../packages/solid/src/icons/style/broken.ts"],
            "@solar-icons/solid/line-duotone": [
                "../../packages/solid/src/icons/style/line-duotone.ts"
            ],
            "@solar-icons/solid/linear": ["../../packages/solid/src/icons/style/linear.ts"],
            "@solar-icons/solid/outline": ["../../packages/solid/src/icons/style/outline.ts"]
        },
        "allowImportingTsExtensions": true,
        "types": ["vite/client"],
        "noEmit": true
    },
    "include": ["./src/**/*", "./vite.config.ts"],
    "exclude": ["dist", "node_modules"]
}
