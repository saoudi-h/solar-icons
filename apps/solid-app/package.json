{
    "name": "solid-app",
    "version": "2.0.0-beta.0",
    "private": true,
    "type": "module",
    "scripts": {
        "predev": "pnpm prepare:catalog",
        "dev": "vite",
        "prebuild": "pnpm prepare:catalog",
        "build": "vite build",
        "preview": "vite preview",
        "clean": "rm -rf node_modules dist",
        "lint": "oxlint --deny-warnings .",
        "lint:fix": "oxlint --fix .",
        "format": "oxfmt --check .",
        "format:fix": "oxfmt --write .",
        "typecheck": "tsc --noEmit",
        "prepare:catalog": "pnpm -w generate:test-catalogs && pnpm --filter @solar-icons/solid generate:assets",
        "generate:icons": "tsx scripts/generate-icon-list.ts",
        "pre-commit": "lint-staged"
    },
    "dependencies": {
        "@solar-icons/solid": "workspace:*",
        "solid-js": "^1.9.14"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "tailwindcss": "^4.3.3",
        "typescript": "7.0.2",
        "vite": "^8.2.0",
        "vite-plugin-solid": "^2.11.14"
    }
}
