{
    "name": "@solar-icons/docs-start",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "sideEffects": false,
    "scripts": {
        "dev": "vite dev",
        "build": "pnpm ensure:icon-package && pnpm sync:umami && pnpm generate:icons && pnpm check:icons && pnpm generate:catalog && pnpm generate:og-assets && pnpm generate:changelog && pnpm generate:og-images && pnpm fetch:avatar && pnpm optimize:images && pnpm generate:static-config && pnpm generate:icon-catalog && pnpm generate:hero-icons && pnpm generate:site-stats && vite build",
        "preview": "vite preview",
        "test": "vitest run && playwright test",
        "test:ui": "playwright test --ui",
        "sync:umami": "tsx ./scripts/sync-umami.ts",
        "typecheck": "tsc --noEmit",
        "pretypecheck": "pnpm ensure:icon-package && pnpm generate:icon-catalog && pnpm generate:hero-icons && pnpm generate:site-stats",
        "lint": "oxlint --deny-warnings . && pnpm lint:links",
        "format": "oxfmt --check .",
        "format:fix": "oxfmt --write .",
        "deploy": "pnpm build && wrangler deploy",
        "deploy:dry": "pnpm build && wrangler deploy --dry-run",
        "cf-typegen": "wrangler types",
        "generate:static-config": "tsx ./scripts/generate-static-config.ts",
        "generate:og-images": "tsx ./scripts/generate-og-images.tsx",
        "generate:icon-catalog": "tsx ./scripts/generate-icon-catalog.ts",
        "ensure:icon-package": "tsx ./scripts/ensure-icon-package.ts",
        "fetch:avatar": "tsx ./scripts/fetch-github-avatar.ts",
        "optimize:images": "tsx ./scripts/optimize-images.ts",
        "generate:site-stats": "tsx ./scripts/generate-site-stats.ts",
        "generate:hero-icons": "tsx ./scripts/generate-hero-icons.ts",
        "test:unit": "vitest run",
        "test:e2e": "playwright test",
        "feedback:list": "tsx ./scripts/list-feedback-discussions.ts",
        "generate:icons": "tsx ./scripts/generate-icons.ts",
        "check:icons": "tsx ./scripts/check-icons.ts",
        "generate:data": "tsx ./scripts/generate-data.ts",
        "generate:descriptions": "tsx ./scripts/generate-descriptions.ts",
        "generate:hero:utils": "tsx ./scripts/generateHeroUtils.ts",
        "generate:categories": "tsx ./scripts/generate-categories.ts",
        "generate:catalog": "pnpm generate:data && pnpm generate:descriptions && pnpm generate:hero:utils && pnpm generate:categories",
        "generate:og-assets": "tsx ./scripts/generate-og-icon-field.ts",
        "generate:changelog": "tsx ./scripts/generate-changelog.ts",
        "generate:banner": "node ./scripts/generate-readme-banner.mjs",
        "lint:links": "tsx ./scripts/check-links.ts"
    },
    "dependencies": {
        "@number-flow/react": "^0.6.2",
        "@radix-ui/react-dialog": "^1.3.1",
        "@radix-ui/react-popover": "^1.3.1",
        "@radix-ui/react-separator": "^1.2.0",
        "@radix-ui/react-slot": "^1.5.0",
        "@radix-ui/react-tooltip": "^1.4.1",
        "@solar-icons/react": "workspace:*",
        "@tanstack/react-router": "^1.170.45",
        "@tanstack/react-start": "^1.169.3",
        "@tanstack/react-virtual": "3.14.21",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "file-saver": "^2.0.5",
        "fumadocs-core": "16.17.7",
        "fumadocs-mdx": "15.4.9",
        "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.7",
        "fuse.js": "7.5.0",
        "jotai": "^3.0.1",
        "lenis": "^1.3.27",
        "motion": "^13.5.1",
        "next-themes": "0.4.6",
        "react": "^19.3.1",
        "react-colorful": "^5.8.1",
        "react-dom": "^19.3.1",
        "react-virtualized": "^9.22.6",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0",
        "vaul": "^1.1.2",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@fontsource/aleo": "^5.3.0",
        "@fontsource/host-grotesk": "^5.3.0",
        "@playwright/test": "^1.64.1",
        "@resvg/resvg-js": "^2.6.2",
        "@solar-icons/core": "workspace:*",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/intent": "^0.5.6",
        "@types/file-saver": "^2.0.7",
        "@types/mdx": "2.0.14",
        "@types/node": "26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/react-virtualized": "^9.22.4",
        "@vitejs/plugin-react": "^6.1.2",
        "satori": "^0.63.2",
        "sharp": "0.35.5",
        "tailwindcss": "^4.3.3",
        "tailwindcss-animate": "^1.0.7",
        "tsx": "^4.20.6",
        "typescript": "7.0.2",
        "vite": "^8.3.5",
        "vitest": "^5.0.5",
        "wrangler": "^4.151.3"
    }
}
