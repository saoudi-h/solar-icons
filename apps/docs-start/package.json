{
    "name": "@solar-icons/docs-start",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "sideEffects": false,
    "scripts": {
        "dev": "vite dev",
        "build": "pnpm ensure:icon-package && pnpm sync:umami && pnpm sync:site-assets && pnpm fetch:avatar && pnpm optimize:images && pnpm generate:static-config && pnpm generate:icon-catalog && pnpm generate:site-stats && vite build",
        "preview": "vite preview",
        "test": "playwright test",
        "test:ui": "playwright test --ui",
        "sync:umami": "tsx ./scripts/sync-umami.ts",
        "typecheck": "tsc --noEmit",
        "pretypecheck": "pnpm ensure:icon-package && pnpm generate:icon-catalog && pnpm generate:site-stats",
        "lint": "oxlint --deny-warnings .",
        "format": "oxfmt --check .",
        "format:fix": "oxfmt --write .",
        "deploy": "pnpm build && wrangler deploy",
        "deploy:dry": "pnpm build && wrangler deploy --dry-run",
        "cf-typegen": "wrangler types",
        "generate:static-config": "tsx ./scripts/generate-static-config.ts",
        "generate:icon-catalog": "tsx ./scripts/generate-icon-catalog.ts",
        "ensure:icon-package": "tsx ./scripts/ensure-icon-package.ts",
        "fetch:avatar": "tsx ./scripts/fetch-github-avatar.ts",
        "sync:site-assets": "tsx ./scripts/sync-site-assets.ts",
        "optimize:images": "tsx ./scripts/optimize-images.ts",
        "generate:site-stats": "tsx ./scripts/generate-site-stats.ts"
    },
    "dependencies": {
        "@solar-icons/react": "workspace:*",
        "@tanstack/react-router": "^1.170.45",
        "@tanstack/react-start": "^1.169.3",
        "@tanstack/react-virtual": "3.14.21",
        "fumadocs-core": "16.17.7",
        "fumadocs-mdx": "15.4.9",
        "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.7",
        "fuse.js": "7.5.0",
        "jotai": "^3.0.1",
        "lenis": "^1.3.27",
        "next-themes": "0.4.6",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@solar-icons/core": "workspace:*",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/intent": "^0.5.6",
        "@types/mdx": "2.0.14",
        "@types/node": "26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "sharp": "0.35.5",
        "tailwindcss": "^4.3.3",
        "tailwindcss-animate": "^1.0.7",
        "tsx": "^4.20.6",
        "typescript": "7.0.2",
        "vite": "^8.3.5",
        "wrangler": "^4.151.3"
    }
}
