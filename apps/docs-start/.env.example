# The canonical origin of the site, used for the canonical links and the
# sitemap. Defaults to https://solar-icons.dev.
VITE_SITE_URL=https://solar-icons.dev

# Add the noindex headers and the robots file of a test deployment.
SITE_NOINDEX=1

# The endpoint that stores the feedback of the documentation pages. It is the
# Worker of the `apps/docs-feedback` package, and its origin must be listed
# in its ALLOWED_ORIGINS variable.
# VITE_FEEDBACK_ENDPOINT=https://solar-icons-docs-feedback.<subdomain>.workers.dev
