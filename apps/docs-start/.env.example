# The canonical origin of the site, used for the canonical links and the
# sitemap. Defaults to https://solar-icons.dev.
VITE_SITE_URL=https://solar-icons.dev

# Add the noindex headers and the robots file of a test deployment.
SITE_NOINDEX=1

# The endpoint that stores the feedback of the documentation pages. It
# defaults to `/api/feedback`, which the Worker of this app answers. Change
# it when the site and the Worker answer from two different addresses.
# VITE_FEEDBACK_ENDPOINT=https://solar-icons-docs-start-test.<subdomain>.workers.dev/api/feedback
